{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/harness-guard.py"],
            "timeout": 30,
            "statusMessage": "harness-guard: ルール照合中"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/harness-guard.py"],
            "timeout": 30,
            "statusMessage": "harness-guard: ルール照合中"
          }
        ]
      }
    ]
  }
}
